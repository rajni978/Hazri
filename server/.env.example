# Copy this file to server/.env only if you want to change the defaults.
# Do not put passwords or API keys here until a later feature needs them.
# .env is ignored by Git. .env.example is safe to keep in the repository.

# Port the API listens on. The code uses 5000 when this is unset.
PORT=5000

# The Vite dev server origin that is allowed to call the API from the browser.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string. Replace with your own MongoDB Atlas or local URI.
# Never put real credentials in this file.
MONGODB_URI=mongodb://localhost:27017/hazri
